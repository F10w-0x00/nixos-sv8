{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ⇢  "
  },
  "modules": [
    "break",
    // ----------------- 1. 发行版信息 -----------------
    {
      "type": "os",
      "key": "󱄅 DISTRO",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "├── ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "├── 󰏖",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "├── 󰔛",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "└── ",
      "keyColor": "cyan"
    },

    // ----------------- 2. 桌面与环境 -----------------
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "yellow"
    },
    {
      "type": "theme",
      "key": "├── 󰒓",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "├── 󰆿",
      "keyColor": "yellow"
    },
    {
      "type": "font",
      "key": "├── 󰬚",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "└── 󰞷",
      "keyColor": "yellow"
    },

    // ----------------- 3. 硬件规格 -----------------
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "├── 󰍛",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├── 󰢮",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "├── 󰍹",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "├── 󰘚",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "├── 󰋊",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "└── 󰥔",
      "keyColor": "green"
    },

    // ----------------- 4. 音频输出 -----------------
    {
      "type": "sound",
      "key": "󰕾 AUDIO",
      "keyColor": "magenta"
    },

    // ----------------- 5. Catppuccin 色谱展示 -----------------
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m  \u001b[38;2;243;139;168m  \u001b[38;2;250;179;135m  \u001b[38;2;249;226;175m  \u001b[38;2;166;227;161m  \u001b[38;2;148;226;213m  \u001b[38;2;116;199;236m  \u001b[38;2;137;180;250m  \u001b[38;2;180;190;254m  \u001b[38;2;242;205;205m  \u001b[38;2;203;166;247m  \u001b[38;2;242;205;205m  \u001b[38;2;180;190;254m  \u001b[38;2;137;180;250m  \u001b[38;2;116;199;236m  \u001b[38;2;148;226;213m  \u001b[38;2;166;227;161m  \u001b[38;2;249;226;175m  \u001b[38;2;250;179;135m  \u001b[38;2;243;139;168m  \u001b[38;2;88;91;112m"
    },
    "break"
  ]
}

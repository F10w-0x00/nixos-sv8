# ==============================================================================
# Zathura Configuration — Catppuccin Mocha (Optimized for Panasonic CF-SV8)
# ==============================================================================

# 打开文件时默认适合页面宽度 (16:10 屏幕阅读最佳)
set adjust-open "width"

# 平滑滚动步进
set scroll-step 50
set scroll-wrap false

# 选中文字自动复制到系统剪贴板 (与 xclip 联动)
set selection-clipboard clipboard

# 字体与界面缩放
set font "JetBrainsMono Nerd Font 11"

# ── Catppuccin Mocha 配色 ───────────────────────────────────────────────────
set default-bg                  "#1e1e2e"
set default-fg                  "#cdd6f4"

set statusbar-bg                "#181825"
set statusbar-fg                "#cdd6f4"

set inputbar-bg                 "#11111b"
set inputbar-fg                 "#cdd6f4"

set notification-bg             "#181825"
set notification-fg             "#cdd6f4"

set notification-error-bg       "#181825"
set notification-error-fg       "#f38ba8"

set notification-warning-bg     "#181825"
set notification-warning-fg     "#f9e2af"

set highlight-color             "#89b4fa"
set highlight-active-color      "#f5c2e7"

set completion-bg               "#181825"
set completion-fg               "#cdd6f4"
set completion-highlight-bg     "#89b4fa"
set completion-highlight-fg     "#1e1e2e"

# 护眼暗色模式 (按 Ctrl + r 快速切换)
set recolor-lightcolor          "#1e1e2e"
set recolor-darkcolor           "#cdd6f4"
set recolor                     "false"
set recolor-keephue             "true"

# 快捷键微调：按 d 切换双页并排阅读
map d toggle_page_mode
